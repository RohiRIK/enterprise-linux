# enterprise-linux -- screen lock defaults (layer 16). Locked in locks/.
# Values are the baseline; eld renders policy overrides into this db.
[org/gnome/desktop/session]
# Blank after 5 minutes idle (policy: desktop.screensaver.timeout)
idle-delay=uint32 300

[org/gnome/desktop/screensaver]
lock-enabled=true
# Lock immediately when the screen blanks
lock-delay=uint32 0
# Ubuntu-specific key (harmless elsewhere): lock when suspending / lid close
ubuntu-lock-on-suspend=true

[org/gnome/desktop/lockdown]
disable-lock-screen=false
disable-user-switching=false

[org/gnome/desktop/notifications]
# No notification content on the lock screen
show-in-lock-screen=false
