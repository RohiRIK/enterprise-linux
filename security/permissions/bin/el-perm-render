#!/usr/bin/python3 -I
"""el-perm-render: see security/permissions/README.md (design stage)."""
import sys
from pathlib import Path

# Repo layout: <dir>/bin/el-perm-render + <dir>/lib/elperm. Installed: /usr/lib/el/permissions/lib.
for cand in (Path(__file__).resolve().parent.parent / "lib", Path("/usr/lib/el/permissions/lib")):
    if (cand / "elperm" / "__init__.py").is_file():
        sys.path.insert(0, str(cand))
        break

from elperm.cli import render_main  # noqa: E402

sys.exit(render_main())
