#!/usr/bin/env python3
import base64, json, sys, _mocklib as m
m.log_call("clevis")
a = sys.argv[1:]
dev = a[a.index("-d") + 1] if "-d" in a else None
if a[:2] == ["luks", "bind"]:
    d = m.load_dev(dev)
    pin = a[-2]
    hdr = base64.urlsafe_b64encode(json.dumps({"clevis": {"pin": pin}}).encode()).decode().rstrip("=")
    m.add_slot(d, token={"type": "clevis", "jwe": {"protected": hdr}})
    m.save_dev(dev, d); sys.exit(0)
if a[:2] == ["luks", "pass"]:
    print("not-a-real-secret"); sys.exit(0)
sys.exit(2)
