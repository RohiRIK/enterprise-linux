# Tier: ORG DEFAULT, user can change. Nothing here is locked.
# "Reset desktop settings" (helpdesk) clears the user's overrides and
# these values come back.

# Familiar window controls for people coming from Windows or macOS.
[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/desktop/interface]
enable-hot-corners=false
clock-show-weekday=true
show-battery-percentage=true

# English and Hebrew keyboards out of the box; locale packs may replace this.
[org/gnome/desktop/input-sources]
sources=[('xkb', 'us'), ('xkb', 'il')]

[org/gnome/system/location]
enabled=false

[org/gnome/mutter]
center-new-windows=true

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
