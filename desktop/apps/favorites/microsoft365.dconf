# Tier: org default. Dock favorites for the catalog profile "microsoft365".
# Several IDs per app on purpose: the launcher name differs per package
# family, and GNOME Shell skips favorites that are not installed.
[org/gnome/shell]
favorite-apps=['microsoft-edge.desktop', 'firefox-esr.desktop', 'firefox.desktop', 'org.mozilla.firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.enterpriselinux.Workplace.desktop']
