        "installation_mode": "blocked",
        "blocked_install_message": "Extensions are managed by your organization. Ask IT in the Workplace app."
      }
    },
    "UserMessaging": {
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "MoreFromMozilla": false,
      "SkipOnboarding": true,
      "Locked": true
    }
  }
}
